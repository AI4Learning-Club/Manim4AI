# Only keep the publishable project surface
/*
!/.gitignore
!/README.md
!/requirements.txt
!/app.py
!/agent_pipeline/
!/agent_pipeline/**
!/colortest/
!/colortest/**
!/eval_pipeline/
!/eval_pipeline/**
!/icon/
!/icon/**
!/mcp_server/
!/mcp_server/**
!/remotion_renderer/
!/remotion_renderer/**
!/manim_mcp_http.py
!/manim_mcp_runtime.py
!/delivery.py
!/prompt_contract.py
!/runtime_config.py
!/tests/
!/tests/**

# Re-ignore generated and vendored content under remotion renderer
remotion_renderer/node_modules/
remotion_renderer/.cache/
remotion_renderer/.remotion/
remotion_renderer/public/runtime/

# Python caches and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
eggs/
.eggs/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Local config and secrets
.env
.env.local
*.local

# IDE / OS noise
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Test / tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
